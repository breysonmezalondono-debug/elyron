# ============================================================
# ELIRYON · FRONTEND ENVIRONMENT VARIABLES
# Copia este archivo a `.env` y ajusta los valores.
# ============================================================

# ---- Microservicios (FastAPI / Laravel) ----
# URL base común del backend. Si abres la app desde un celular en la misma red,
# usa la IP local de tu PC (NO localhost):  http://IP-DE-TU-PC:3000
# VITE_API_URL=http://localhost:3000

# URL base del microservicio de Autenticación (Auth Service).
VITE_AUTH_URL=http://localhost:3000/api

# URL base del microservicio educativo núcleo (EduCore Service):
# perfiles, fichas, evidencias, comunidad, ofertas, etc.
VITE_EDUCORE_URL=http://localhost:3000/api

# URL base del microservicio de IA (ia-service) que alimenta al Tutor Elir.
VITE_AI_URL=http://localhost:8000

# ---- Modo demo ----
# true  = usa los datos Mock internos (sin backend, todo funciona).
# false = hace llamadas HTTP reales a VITE_AUTH_URL / VITE_EDUCORE_URL.
VITE_USE_MOCK_AUTH=true
