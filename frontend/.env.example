# ============================================================
# ELYRON · FRONTEND ENVIRONMENT VARIABLES (.env.example)
# Copia a `.env` y ajusta. NUNCA subas `.env`.
# En el host estático (Vercel/Cloudflare Pages) define estas variables
# en la configuración del proyecto ANTES del build.
# ============================================================

# ---------- Backend (API) ----------
# URL base del backend NestJS. En producción:
#   https://api.elyron.com/api   (si la API usa el prefijo /api)
# y el frontend añade /api por las rutas de servicios. Deja VITE_AUTH_URL y
# VITE_EDUCORE_URL vacías para que usen VITE_API_URL automáticamente.
VITE_API_URL=https://api.elyron.com
VITE_AUTH_URL=
VITE_EDUCORE_URL=

# ---------- Servicio de IA (ia-service) ----------
# Solo si algún componente conectara directo al ia-service. El chat de Elir
# pasa por el backend, así que en la versión actual NO se necesita en prod.
VITE_AI_URL=

# ---------- Modo demo ----------
# true  = datos mock (SIN backend), solo para desarrollo local.
# false u omitido = llamadas reales al backend (producción).
VITE_USE_MOCK_AUTH=false