# ============================================================
#  Elyron · .gitignore raíz
#  Nunca se suben secretos, datos reales ni artefactos.
# ============================================================

# ---------- Dependencias ----------
node_modules/

# ---------- Variables de entorno (NUNCA subir) ----------
.env
.env.*
!.env.example

# ---------- Build / artefactos ----------
dist/
build/
coverage/
*.tsbuildinfo

# ---------- Logs ----------
*.log
logs/

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/

# ---------- IDE / SO ----------
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---------- Temporal ----------
tmp/
temp/
*.tmp

# ---------- Subidas / datos de usuario (NUNCA) ----------
uploads/
storage/
user-uploads/
backend/uploads/*
# Excepción: el módulo de almacenamiento (código de producción) SÍ se versiona.
!backend/src/common/storage/

# ---------- Bases de datos / backups (NUNCA) ----------
*.sql
*.dump
*.bak
*.sqlite
*.sqlite3
# Excepción: el esquema inicial reproducible SÍ se versiona (necesario para
# las migraciones de producción).
!backend/src/database/migrations/initial-schema.sql

# ---------- Secretos / certificados / credenciales ----------
*.pem
*.key
*.p12
*.pfx
*.crt
credentials.json
service-account.json
firebase-adminsdk.json
*.p8
# Archivos locales con credenciales temporales (nunca subir)
*_PASSWORD*.txt
ADMIN_PASSWORD*