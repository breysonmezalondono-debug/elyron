# ============================================================
# ELYRON · BACKEND ENVIRONMENT (.env.example)
# Copia a `.env` y ajusta. NUNCA subas `.env` al repositorio.
# En producción todas las variables obligatorias deben estar definidas;
# el backend falla al arrancar si falta alguna crítica.
# ============================================================

# ---------- Aplicación ----------
# development | production
NODE_ENV=development
# Puerto dinámico asignado por el host (Render/Railway/Cloud). No fijar en duro.
PORT=3000

# ---------- Base de datos (MySQL 8 administrado, p. ej. Aiven) ----------
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=elyron
DB_PASSWORD=
DB_NAME=elyron_db
# En dev, si no hay MySQL local levanta uno en Docker automáticamente.
DB_FALLBACK_ENABLED=true
# Puerto del contenedor MySQL de respaldo (solo dev).
DB_DOCKER_PORT=3306

# ---------- Autenticación JWT ----------
# OBLIGATORIAS en producción; no usar valores por defecto.
JWT_SECRET=
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=7d

# ---------- Frontend / CORS / URLs públicas ----------
# Origen(es) permitidos por CORS, separados por comas. En producción el
# dominio real del frontend: https://elyron.com
FRONTEND_URL=http://localhost:5173,http://localhost:5174
# URL base pública del frontend usada en enlaces de correos.
APP_URL=http://localhost:3000
# URL base pública del backend (OAuth callback y assets). En producción:
# https://api.elyron.com
PUBLIC_API_URL=http://localhost:3000

# ---------- Seed (npm run seed) ----------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ---------- Archivos (metadatos en BD; bytes en StorageService) ----------
# local | s3
STORAGE_PROVIDER=local
# Directorio local (solo si STORAGE_PROVIDER=local; NO apto para hosting efímero)
UPLOAD_DIR=./uploads
# Límite por archivo en bytes (default 50 MB)
MAX_FILE_SIZE=52428800

# ---------- Storage S3-compatible (Cloudflare R2 / Backblaze B2) ----------
# Solo si STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=true

# ---------- IA educativa (OpenAI-compatible) ----------
# Ruta del ia-service (extracción de texto de documentos). En producción:
# https://ia.elyron.com o el dominio del servicio desplegado.
IA_SERVICE_URL=http://localhost:8000
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2000

# ---------- Redis (reservado, uso futuro) ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- Correo ----------
# false = modo preview (no envía). true = envía de verdad.
MAIL_ENABLED=false
# smtp (nodemailer) | resend (HTTP API, recomendado si el host bloquea SMTP)
MAIL_PROVIDER=smtp

# --- Si MAIL_PROVIDER=smtp ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Si MAIL_PROVIDER=resend (gratis 3.000/mes; puerto 443) ---
RESEND_API_KEY=
MAIL_FROM=

# ---------- Recuperación de contraseña ----------
RESET_PASSWORD_TTL_MINUTES=15

# ---------- Inicio de sesión social (OAuth) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
