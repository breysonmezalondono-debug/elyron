# Base de datos (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=elyron
DB_PASSWORD=your_password_here
DB_NAME=elyron_db

# AutenticaciÃ³n JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRATION=7d

# Servidor
PORT=3000
NODE_ENV=development
# URL pública del frontend usada en los enlaces de los correos (verificación y
# recuperación). En desarrollo usa la IP local de tu PC para abrirlo desde un
# celular en la misma red:  http://IP-DE-TU-PC:3000
# En producción:  https://tu-dominio
APP_URL=http://localhost:3000
# Orígenes permitidos en CORS (separados por comas). Incluye la IP LAN del
# frontend si lo abres desde otro dispositivo.
FRONTEND_URL=http://localhost:5173,http://localhost:5174

# Seed inicial (npm run seed) - credenciales del usuario administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CambiaEstaPassword123*

# Archivos
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# IA educativa (compatible con OpenAI chat completions)
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2000

# Redis (reservado para uso futuro)
REDIS_HOST=localhost
REDIS_PORT=6379

# ============ Correo (SMTP) ============
# MAIL_ENABLED=true + SMTP_USER/SMTP_PASS para enviar de verdad.
# Con Gmail usa una "contraseña de aplicación" (no la clave normal).
# Si MAIL_ENABLED=false los correos se imprimen en consola (modo preview).
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ============ Recuperación de contraseña ============
# TTL del enlace de recuperación en minutos (por defecto 15).
RESET_PASSWORD_TTL_MINUTES=15

# URL publica del backend (callback OAuth y enlaces dentro de los correos).
# En producción debe ser https://tu-dominio
PUBLIC_API_URL=http://localhost:3000

# ============ Inicio de sesión social (OAuth) ============
# Google  -> https://console.cloud.google.com/apis/credentials  (OAuth Client ID)
# GitHub  -> https://github.com/settings/developers
# Microsoft -> https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
# Autoriza la redirect: {PUBLIC_API_URL}/api/auth/oauth/{google|github|microsoft}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
